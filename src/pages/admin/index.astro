---
import BaseLayout from '@layouts/BaseLayout.astro';
import AdminApp from '@components/admin/AdminApp';
import { DEFAULT_LOCALE, translator } from '@lib/i18n';

/**
 * The admin.
 *
 * A single Preact island, hydrated on load, and the only page on the site that ships a
 * component framework. `client:load` rather than `client:idle` because this is the whole
 * page — deferring it would show an empty shell to someone who navigated here on purpose.
 *
 * The registry is injected at build time when the deployment provides one. It is not
 * committed to this repository and never will be; see docs/site-registry.md.
 */
const locale = DEFAULT_LOCALE;
const t = translator(locale);

const registryJson = import.meta.env.PUBLIC_SITE_REGISTRY as string | undefined;
---

<BaseLayout
  title={t('admin.title')}
  description={t('admin.signInHelp')}
  path="/admin"
  locale={locale}
  noindex={true}
>
  <div class="wrap admin-page">
    <AdminApp client:load locale={locale} registryJson={registryJson} />
  </div>
</BaseLayout>

<style is:global>
  .admin-page {
    padding-block: var(--space-10);
  }

  .admin--connect {
    max-inline-size: 34rem;
  }

  .admin__help {
    margin-block: var(--space-4);
    color: var(--ink-600);
  }

  .admin__form {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-6);
  }

  .admin__form label {
    font-family: var(--font-ui);
    font-size: var(--size-sm);
    color: var(--ink-600);
  }

  .admin__form input {
    padding: var(--space-2) var(--space-3);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background-color: var(--paper);
    color: var(--ink-900);
    font-family: var(--font-mono);
  }

  .admin__form button {
    justify-self: start;
    padding: var(--space-2) var(--space-5);
    border: var(--hairline) solid var(--accent);
    border-radius: var(--radius);
    background-color: var(--accent);
    color: var(--accent-contrast);
    cursor: pointer;
  }

  .admin__form button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  .admin__notice,
  .admin__error,
  .admin__ok {
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .admin__notice {
    color: var(--ink-500);
  }

  .admin__error {
    color: var(--danger);
  }

  .admin__ok {
    color: var(--success);
  }

  .admin__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block-end: var(--space-4);
    border-block-end: var(--hairline) solid var(--rule);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .admin__who {
    margin-inline-start: auto;
    color: var(--ink-500);
  }

  .admin__link-button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    cursor: pointer;
    text-decoration: underline;
    font-size: inherit;
  }

  .admin__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-5);
  }

  .admin__tab {
    padding: var(--space-1) var(--space-3);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background: none;
    color: var(--ink-600);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
    cursor: pointer;
  }

  .admin__tab--active {
    color: var(--accent-contrast);
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .admin__panel {
    padding-block: var(--space-4);
  }

  .admin__stats {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
    margin-block: var(--space-5);
  }

  .admin__stats dt {
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .admin__stats dd {
    margin: 0;
    font-size: var(--size-2xl);
    font-family: var(--font-display);
  }

  .admin__table {
    inline-size: 100%;
    border-collapse: collapse;
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .admin__table th,
  .admin__table td {
    padding: var(--space-2) var(--space-3);
    text-align: start;
    border-block-end: var(--hairline) solid var(--rule);
  }

  .admin__table th {
    color: var(--ink-500);
    font-weight: var(--weight-medium);
  }
</style>

<style is:global>
  /* --- filters and scope pickers --- */
  .admin__scope,
  .admin__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .admin__scope select,
  .admin__filters select,
  .admin__filters input {
    padding: var(--space-1) var(--space-2);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background-color: var(--paper);
    color: var(--ink-900);
  }

  .admin__warning {
    margin-block: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-inline-start: 3px solid var(--warning);
    background-color: var(--surface);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .admin__problems {
    margin-block: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-inline-start: 3px solid var(--danger);
    background-color: var(--surface);
    border-radius: var(--radius);
    font-size: var(--size-sm);
  }

  .state {
    padding-inline: var(--space-2);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    font-size: var(--size-xs);
  }

  .state--published {
    border-color: var(--success);
    color: var(--success);
  }
  .state--rejected {
    border-color: var(--danger);
    color: var(--danger);
  }
  .state--in-review {
    border-color: var(--warning);
    color: var(--warning);
  }

  /* --- the editor --- */
  .editor-panel__bar {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-block-end: var(--hairline) solid var(--rule);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .editor-panel__state {
    margin-inline-start: auto;
    color: var(--ink-500);
  }

  .editor-panel__save {
    padding: var(--space-1) var(--space-4);
    border: var(--hairline) solid var(--accent);
    border-radius: var(--radius);
    background-color: var(--accent);
    color: var(--accent-contrast);
    cursor: pointer;
  }

  .editor-panel__fields {
    display: grid;
    gap: var(--space-2);
    margin-block: var(--space-5);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .editor-panel__fields input,
  .editor-panel__fields textarea,
  .editor-panel__seo input,
  .editor-panel__seo textarea {
    inline-size: 100%;
    padding: var(--space-2);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background-color: var(--paper);
    color: var(--ink-900);
    font-family: inherit;
  }

  .editor-panel__slug {
    display: flex;
    gap: var(--space-2);
  }

  .editor__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-block-end: var(--space-2);
  }

  .editor__toolbar button {
    padding: var(--space-1) var(--space-2);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background: none;
    color: var(--ink-600);
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    cursor: pointer;
  }

  .editor__panes {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 60rem) {
    .editor__panes {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .editor__input {
    inline-size: 100%;
    padding: var(--space-3);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background-color: var(--paper);
    color: var(--ink-900);
    font-family: var(--font-mono);
    font-size: var(--size-sm);
    line-height: 1.6;
    resize: vertical;
  }

  .editor__input--dragging {
    border-color: var(--accent);
  }

  .editor__preview {
    inline-size: 100%;
    min-block-size: 24rem;
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background-color: var(--paper);
  }

  .counter {
    font-size: var(--size-xs);
    color: var(--ink-500);
  }
  .counter--over {
    color: var(--danger);
  }

  .social-preview {
    max-inline-size: 32rem;
    padding: var(--space-3);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
  }

  .social-preview__title {
    color: var(--accent);
    font-weight: var(--weight-medium);
  }
  .social-preview__description {
    color: var(--ink-600);
    font-size: var(--size-sm);
  }
  .social-preview__url {
    color: var(--ink-500);
    font-size: var(--size-xs);
  }

  /* --- review queue --- */
  .queue-item {
    padding-block: var(--space-5);
    border-block-end: var(--hairline) solid var(--rule);
  }

  .queue-item__header h3 {
    margin-block: 0 var(--space-1);
  }

  .queue-item__excerpt {
    margin-block: var(--space-2);
    color: var(--ink-600);
    max-inline-size: var(--measure-latin);
  }

  .queue-item textarea {
    inline-size: 100%;
    max-inline-size: 40rem;
    margin-block: var(--space-2);
    padding: var(--space-2);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background-color: var(--paper);
    color: var(--ink-900);
    font-family: inherit;
    font-size: var(--size-sm);
  }

  .queue-item__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .queue-item__actions button {
    padding: var(--space-1) var(--space-4);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
    background: none;
    color: var(--ink-900);
    font-family: var(--font-ui);
    font-size: var(--size-sm);
    cursor: pointer;
  }

  .queue-item__actions button[disabled] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .queue-item__reject {
    color: var(--danger);
  }
</style>
