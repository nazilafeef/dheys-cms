---
import { translator, type LocaleCode } from '@lib/i18n';
import { tableOfContents } from '@lib/collections';

export interface Props {
  body: string;
  locale: LocaleCode;
}

const { body, locale } = Astro.props;
const t = translator(locale);
const entries = tableOfContents(body);
---

{
  entries.length >= 2 && (
    <nav class="toc" aria-labelledby="toc-heading">
      <h2 id="toc-heading" class="toc__heading">
        {t('article.tableOfContents')}
      </h2>
      <ol class="toc__list">
        {entries.map((entry) => (
          <li class:list={['toc__item', `toc__item--depth-${entry.depth}`]}>
            <a href={`#${entry.slug}`}>{entry.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    margin-block: var(--space-6);
    padding: var(--space-4);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
  }

  .toc__heading {
    margin-block: 0 var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--size-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-500);
  }

  .toc__list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .toc__item + .toc__item {
    margin-block-start: var(--space-1);
  }

  /* Logical inset, so nesting indents from the correct edge in RTL. */
  .toc__item--depth-3 {
    padding-inline-start: var(--space-4);
  }

  .toc__list a {
    color: var(--ink-600);
    text-decoration: none;
  }

  .toc__list a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
