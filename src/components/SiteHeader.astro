---
import BrandMark from '@components/BrandMark.astro';
import LocaleSwitcher from '@components/LocaleSwitcher.astro';
import ThemeToggle from '@components/ThemeToggle.astro';
import { translator, type LocaleCode } from '@lib/i18n';
import { routes } from '@lib/routes';

export interface Props {
  locale: LocaleCode;
  availableLocales?: readonly LocaleCode[];
  currentPath: string;
  /** Per-locale URLs, when a translation does not share the current slug. */
  localeUrls?: Partial<Record<LocaleCode, string>> | undefined;
}

const { locale, availableLocales = [locale], currentPath, localeUrls } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = translator(locale);
const ctx = { locale, base };
const themeName = import.meta.env.PUBLIC_THEME === 'dheys' ? 'dheys' : 'bare';

const links = [
  { href: routes.home(ctx), label: t('nav.home'), path: '/' },
  { href: routes.archive(ctx), label: t('nav.articles'), path: '/archive' },
  { href: routes.search(ctx), label: t('nav.search'), path: '/search' },
];
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href={routes.home(ctx)}>
      <BrandMark theme={themeName} label={t('site.title')} />
    </a>

    <nav class="site-header__nav" aria-label={t('nav.menu')}>
      <ul class="site-header__list">
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={currentPath === link.path ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__tools">
      <LocaleSwitcher
        locale={locale}
        availableLocales={availableLocales}
        currentPath={currentPath}
        localeUrls={localeUrls}
      />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    border-block-end: var(--hairline) solid var(--rule);
    background-color: var(--paper);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding-block: var(--space-4);
    flex-wrap: wrap;
  }

  .site-header__brand {
    color: inherit;
    text-decoration: none;
    margin-inline-end: auto;
  }

  .site-header__list {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--size-sm);
  }

  .site-header__list a {
    color: var(--ink-600);
    text-decoration: none;
    padding-block: var(--space-1);
  }

  .site-header__list a:hover,
  .site-header__list a[aria-current='page'] {
    color: var(--ink-900);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .site-header__tools {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  @media (max-width: 34rem) {
    .site-header__inner {
      gap: var(--space-3);
    }

    .site-header__brand {
      flex-basis: 100%;
    }
  }
</style>
