---
import { formatDate, isoDate, translator, type LocaleCode } from '@lib/i18n';
import { readingTimeMinutes } from '@lib/collections';
import { routes } from '@lib/routes';
import type { Post } from '@lib/schemas';

export interface Props {
  item: Post;
  body: string;
  locale: LocaleCode;
  categoryLabel?: string;
  /** The first card on a listing gets the h2 that anchors the page outline. */
  headingLevel?: 2 | 3;
}

const { item, body, locale, categoryLabel, headingLevel = 3 } = Astro.props;
const base = import.meta.env.BASE_URL;
const t = translator(locale);
const ctx = { locale, base };
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const minutes = readingTimeMinutes(body, locale);
const isAi = item.sourceType === 'ai' || item.sourceType === 'ai-assisted';
---

<article class="post-card">
  <p class="eyebrow">
    <a href={routes.category(ctx, item.category)}>{categoryLabel ?? item.category}</a>
    {item.pinned && <span class="post-card__pin">★</span>}
  </p>

  <Heading class="post-card__title">
    <a href={routes.article(ctx, item.slug)}>{item.title}</a>
  </Heading>

  <p class="post-card__excerpt">{item.excerpt}</p>

  <p class="meta post-card__meta">
    <span>{t('article.by', { author: item.author })}</span>
    <span aria-hidden="true">·</span>
    <time datetime={isoDate(item.publishedDate)}>{formatDate(item.publishedDate, locale)}</time>
    <span aria-hidden="true">·</span>
    <span>{t('article.readingTime', { minutes })}</span>
    {
      isAi && (
        <>
          <span aria-hidden="true">·</span>
          <span class="post-card__ai">{t('ai.generatedLabel')}</span>
        </>
      )
    }
  </p>
</article>

<style>
  .post-card {
    padding-block-end: var(--space-6);
    border-block-end: var(--hairline) solid var(--rule);
  }

  .post-card__title {
    margin-block: var(--space-2);
    font-size: var(--size-lg);
  }

  .post-card__title a {
    color: var(--ink-900);
    text-decoration: none;
  }

  .post-card__title a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .post-card__excerpt {
    max-inline-size: var(--measure-latin);
    color: var(--ink-600);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-3);
  }

  .post-card__pin {
    color: var(--ink-400);
    margin-inline-start: var(--space-2);
  }

  .post-card__ai {
    padding-inline: var(--space-2);
    border: var(--hairline) solid var(--rule);
    border-radius: var(--radius);
  }

  .eyebrow a {
    color: inherit;
    text-decoration: none;
  }

  .eyebrow a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
