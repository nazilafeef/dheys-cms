{
  "name": "dheys-cms",
  "version": "1.0.0",
  "description": "Multi-site content platform for human and AI-authored editorial workflows, running on static hosting with no server and no database.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nazilafeef/dheys-cms.git"
  },
  "keywords": [
    "cms",
    "astro",
    "static-site",
    "multi-site",
    "editorial",
    "ai-agents",
    "rtl",
    "thaana"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pnpm run build:search",
    "build:search": "pagefind --site dist --output-subdir _pagefind",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:e2e && playwright test",
    "check:clean-room": "node scripts/check-clean-room.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:automation": "node scripts/verify-automation.mjs",
    "check:links": "node scripts/check-links.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "connect": "tsx scripts/connect-site.mjs",
    "link-font": "node scripts/link-font.mjs",
    "gate": "pnpm typecheck && pnpm lint && pnpm test && pnpm check:clean-room && pnpm build && pnpm check:links",
    "scheduler:tick": "tsx scripts/scheduler-tick.ts",
    "agent:run": "tsx scripts/agent-run.ts",
    "build:e2e": "node scripts/build-e2e.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/preact": "^4.1.1",
    "@astrojs/rss": "^4.0.12",
    "astro": "^5.14.1",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.12",
    "preact": "^10.27.2",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.18.6",
    "astro-eslint-parser": "^1.2.2",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.37.0",
    "eslint-plugin-astro": "^1.3.1",
    "lighthouse": "^13.4.1",
    "pagefind": "^1.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.34.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
