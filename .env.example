# Dheys CMS — environment
#
# Copy to .env for local use. NEVER commit a filled-in copy: `pnpm check:clean-room`
# fails the build if a credential-shaped string appears anywhere in the tree or the
# commit history, and it scans untracked files too.
#
# In production none of this lives in a file. Secrets go in Actions secrets, configuration
# goes in Actions variables. See docs/configuration.md.

# ── Build ─────────────────────────────────────────────────────────────────────
# Origin and sub-path. Both hosting modes are supported and both are tested.
#   project page:  https://nazilafeef.github.io  +  /dheys-cms
#   root hosting:  https://cms.example.test      +  /
SITE_URL=
BASE_PATH=

# bare (default) or dheys
PUBLIC_THEME=

# ── Site registry ─────────────────────────────────────────────────────────────
# Exactly one of these. The registry NEVER lives in this repository.
# See docs/site-registry.md.
#
# The JSON itself, which is how a repository secret arrives:
SITE_REGISTRY_JSON=
# ...or a private gist id:
SITE_REGISTRY_GIST=
SITE_REGISTRY_FILENAME=
# ...or a private companion repository, as owner/name[:path][@ref]:
SITE_REGISTRY_REPO=

# ── GitHub ────────────────────────────────────────────────────────────────────
# Writes to CONNECTED SITE repositories, so this is not the workflow token —
# that one cannot reach another repository, which is the intended boundary.
# Fine-grained, scoped to the repositories you manage, with an expiry.
GITHUB_TOKEN=

# ── AI providers ──────────────────────────────────────────────────────────────
# All opt-in. An unset key means that provider is unavailable, and the runner
# says so by name rather than falling back to a different model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# Any endpoint speaking the OpenAI chat-completions shape.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# An existing pipeline of your own. See docs/agent-job-contract.md.
EXTERNAL_AGENT_URL=
EXTERNAL_AGENT_TOKEN=
EXTERNAL_AGENT_TIMEOUT_MS=
EXTERNAL_AGENT_POLL_MS=

# ── Deploy confirmation ───────────────────────────────────────────────────────
# Optional. Without these an adapter reports DELIVERY — that the hook was
# accepted — rather than claiming the deploy actually succeeded.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NETLIFY_AUTH_TOKEN=
VERCEL_TOKEN=

# ── Operations ────────────────────────────────────────────────────────────────
# The kill switch is a repository VARIABLE, not a secret: DHEYS_PUBLISHING_HALTED=true
# halts publishing on every site with no redeploy. It fails closed — if it cannot
# be read, the scheduler assumes it is on.
COST_LEDGER_PATH=
